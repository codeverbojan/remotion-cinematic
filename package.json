{
  "name": "remotion-cinematic",
  "version": "0.2.0",
  "private": false,
  "description": "Create product demo videos from screenshots, recordings or app data with editable Remotion presets for landscape, portrait and square.",
  "license": "MIT",
  "bin": {
    "cinematic-import": "./scripts/cinematic-import.mjs"
  },
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "build": "remotion render src/index.ts CinematicDemo out/video.mp4 --concurrency=1",
    "test": "vitest run --maxWorkers=1 --minWorkers=1 --no-file-parallelism",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "init-video": "tsx src/cli/create-video.ts",
    "import": "tsx src/cli/index.ts",
    "check": "npm run typecheck && npm test",
    "verify:render": "node --import tsx scripts/verify-render.mjs",
    "project": "tsx src/cli/project.ts",
    "examples": "tsx scripts/create-examples.ts"
  },
  "dependencies": {
    "@remotion/cli": "4.0.451",
    "@remotion/google-fonts": "4.0.451",
    "@remotion/studio": "4.0.451",
    "@remotion/zod-types": "4.0.451",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "remotion": "4.0.451",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "@remotion/renderer": "4.0.451",
    "@remotion/bundler": "4.0.451"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/codeverbojan/remotion-cinematic.git"
  },
  "bugs": {
    "url": "https://github.com/codeverbojan/remotion-cinematic/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "remotion",
    "product-demo",
    "video-template",
    "react",
    "typescript",
    "screenshots",
    "video-generation"
  ]
}
